<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.desarrollo.serviciosweb.controller.UsuariosController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <Button text="Consultar" onAction="#onConsultar"/>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="110"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150"/>
            <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="110"/>
            <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
